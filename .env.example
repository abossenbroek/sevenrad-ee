# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Earth Engine Project ID (optional)
# Your GCP project ID for Earth Engine
EE_PROJECT_ID=your-gcp-project-id

# Cache Configuration
# Directory for storing cached API responses and EE results
CACHE_DIR=cache

# VIIRS Configuration
# VIIRS DNB sensor resolution in meters (750m = 750m x 750m pixels at nadir)
# This is the physical resolution of the sensor and determines minimum
# separation between distinct emitters. Do not set below 750m.
# Reference: https://ladsweb.modaps.eosdis.nasa.gov/missions-and-measurements/products/VJ102DNB
VIIRS_SCALE_M=750

# Business Search Configuration
# Search radius for nearby businesses in meters
BUSINESS_SEARCH_RADIUS_M=100

# Perplexity API Configuration (Optional - for AI-powered greenhouse attribution)
# Get your API key from: https://www.perplexity.ai/settings/api
# Required only if using the --attribute-greenhouses feature
PERPLEXITY_API_KEY=your_perplexity_api_key_here
